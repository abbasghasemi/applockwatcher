<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="10dp"
            app:srcCompat="@drawable/icon_lock" />

        <ghasemi.abbas.applockwatcher.components.TextView
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="قفل برنامه ها نسخه 5.2"
            android:textSize="13sp"
            app:bold="true"
            app:color="#000" />

        <LinearLayout
            android:id="@+id/status"
            android:layout_width="460dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:background="?selectableItemBackground"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ghasemi.abbas.applockwatcher.components.Switch
                android:id="@+id/statusSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp" />

            <ghasemi.abbas.applockwatcher.components.TextView
                android:layout_width="wrap_content"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:gravity="right|center"
                android:text="وضعیت قفل اپلیکشن"
                android:textSize="13sp"
                app:bold="true"
                app:color="#212121" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:id="@+id/application"
                android:layout_width="140dp"
                android:layout_height="160dp"
                android:layout_margin="10dp"
                android:foreground="@drawable/select_item"
                app:cardBackgroundColor="@color/colorCardBackground"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:srcCompat="@drawable/lock_home" />

                    <ghasemi.abbas.applockwatcher.components.TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="@string/app_lock"
                        android:textSize="16dp"
                        app:bold="true"
                        app:color="#1A237E" />
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/file"
                android:layout_width="140dp"
                android:layout_height="160dp"
                android:layout_margin="10dp"
                android:foreground="@drawable/select_item"
                app:cardBackgroundColor="@color/colorCardBackground"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:srcCompat="@drawable/folder_home" />

                    <ghasemi.abbas.applockwatcher.components.TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="@string/file_lock"
                        android:textSize="16dp"
                        app:bold="true"
                        app:color="#1A237E" />
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/image"
                android:layout_width="140dp"
                android:layout_height="160dp"
                android:layout_margin="10dp"
                android:foreground="@drawable/select_item"
                app:cardBackgroundColor="@color/colorCardBackground"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:srcCompat="@drawable/image_home" />

                    <ghasemi.abbas.applockwatcher.components.TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="@string/image_lock"
                        android:textSize="16dp"
                        app:bold="true"
                        app:color="#1A237E" />
                </LinearLayout>

            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:id="@+id/video"
                android:layout_width="140dp"
                android:layout_height="160dp"
                android:layout_margin="10dp"
                android:foreground="@drawable/select_item"
                app:cardBackgroundColor="@color/colorCardBackground"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:srcCompat="@drawable/video_home" />

                    <ghasemi.abbas.applockwatcher.components.TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="@string/video_lock"
                        android:textSize="16dp"
                        app:bold="true"
                        app:color="#1A237E" />
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/audio"
                android:layout_width="140dp"
                android:layout_height="160dp"
                android:layout_margin="10dp"
                android:foreground="@drawable/select_item"
                app:cardBackgroundColor="@color/colorCardBackground"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:srcCompat="@drawable/audio_home" />

                    <ghasemi.abbas.applockwatcher.components.TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="@string/audio_lock"
                        android:textSize="16dp"
                        app:bold="true"
                        app:color="#1A237E" />
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/settings"
                android:layout_width="140dp"
                android:layout_height="160dp"
                android:layout_margin="10dp"
                android:foreground="@drawable/select_item"
                app:cardBackgroundColor="@color/colorCardBackground"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:srcCompat="@drawable/settings_home" />

                    <ghasemi.abbas.applockwatcher.components.TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="@string/settings"
                        android:textSize="16dp"
                        app:bold="true"
                        app:color="#1A237E" />
                </LinearLayout>

            </androidx.cardview.widget.CardView>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
