<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    app:cardBackgroundColor="#fff"
    app:cardCornerRadius="15dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_marginTop="15dp"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/s1"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_yellow_star" />

            <ImageView
                android:id="@+id/s2"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginLeft="15dp"
                android:src="@drawable/ic_yellow_star" />

            <ImageView
                android:id="@+id/s3"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginLeft="15dp"
                android:src="@drawable/ic_yellow_star" />

            <ImageView
                android:id="@+id/s4"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginLeft="15dp"
                android:src="@drawable/ic_yellow_star" />

            <ImageView
                android:id="@+id/s5"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginLeft="15dp"
                android:src="@drawable/ic_yellow_star" />

        </LinearLayout>

        <ghasemi.abbas.applockwatcher.components.TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="15dp"
            android:gravity="center"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:textSize="14sp"
            android:text="با ثبت امتیاز برای اپلیکیشن از ما حمایت کنید. \n نظرت برای بهبود اپلیکیشن برای ما اهمیت داره (:"
            app:bold="true"
            app:color="#000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="7dp"
            android:layout_marginBottom="17dp"
            android:orientation="horizontal">

            <com.farasource.component.button.MaterialButton
                android:id="@+id/close"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="5dp"
                android:layout_weight="1"
                android:text="بعدا بپرس"
                android:textColor="@color/colorAccent"
                app:backgroundTint="#fff"
                app:rippleColor="#332FDF84"
                app:strokeColor="@color/colorAccent"
                app:strokeWidth="1dp" />

            <com.farasource.component.button.MaterialButton
                android:id="@+id/star"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="10dp"
                android:layout_weight="1"
                android:text="نظر می دهم"
                android:textColor="#fff" />
        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>