<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/back_bottom_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ghasemi.abbas.applockwatcher.components.TextView
            android:id="@+id/help"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="فراموشی گذرواژه"
            app:bold="true"
            android:textSize="16sp"
            app:color="#404040" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="10dp"
            android:background="@color/colorDivider" />

        <ghasemi.abbas.applockwatcher.components.TextView
            android:id="@+id/question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="5dp"
            android:gravity="right|center"
            android:singleLine="true"
            app:color="#000" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/LockApp.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="10dp">

            <ghasemi.abbas.applockwatcher.components.EditText
                android:id="@+id/answer"
                android:paddingVertical="15dp"
                android:paddingHorizontal="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="پاسخ سوال"
                />

            <requestFocus />
        </com.google.android.material.textfield.TextInputLayout>


        <com.farasource.component.button.MaterialButton
            android:id="@+id/check"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="20dp"
            android:text="بررسی" />

    </LinearLayout>
</ScrollView>