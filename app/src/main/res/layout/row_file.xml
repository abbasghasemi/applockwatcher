<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="3dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="2dp"
        android:foreground="@drawable/select_item"
        app:cardCornerRadius="15dp"
        app:cardElevation="0dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:id="@+id/card_image"
                app:cardElevation="0dp"
                app:cardCornerRadius="10dp"
                app:strokeWidth="0dp"
                android:layout_marginRight="5dp">

                <ImageView
                    android:id="@+id/image"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:adjustViewBounds="true"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>

            <FrameLayout
                android:layout_width="70dp"
                android:layout_height="70dp">

                <ghasemi.abbas.applockwatcher.components.TextView
                    android:id="@+id/duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|right"
                    android:layout_margin="2dp"
                    android:layout_toRightOf="@id/card_image"
                    android:background="@drawable/back_video_duration"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:textSize="10dp"
                    app:color="#fff" />
            </FrameLayout>

            <ghasemi.abbas.applockwatcher.components.TextView
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_toLeftOf="@id/lock"
                android:layout_toRightOf="@id/card_image"
                android:ellipsize="marquee"
                android:gravity="center|left"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:textSize="14sp"
                app:bold="true"
                app:color="#2C2C2C" />

            <ghasemi.abbas.applockwatcher.components.TextView
                android:id="@+id/type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/name"
                android:layout_toLeftOf="@id/lock"
                android:layout_toRightOf="@id/card_image"
                android:gravity="center|left"
                android:textSize="14sp"
                app:color="#494949" />

            <ghasemi.abbas.applockwatcher.components.Lock
                android:id="@+id/lock"
                android:layout_width="30dp"
                android:layout_height="35dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true" />
        </RelativeLayout>

    </androidx.cardview.widget.CardView>
</LinearLayout>